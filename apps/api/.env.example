PORT=3001
# Postgres connection string. Use %40 if the password contains an @.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/motiq_team?schema=public"
JWT_SECRET=change-me-in-local-env
# Comma separated phone numbers that become admins when they log in.
ADMIN_PHONES=+919999900000
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
